# Database Connection Pool Configuration
# These settings control how the application manages database connections.
# Adjust these values based on your database environment (TimescaleDB, CNPG, etc.)

# Minimum number of connections to maintain in the pool (default: 5)
# Higher values reduce connection cold starts but use more resources
DATABASE_MIN_CONNECTIONS=5

# Maximum number of connections allowed in the pool (default: 50)
# Lower values for CNPG environments (recommended: 20-30)
DATABASE_MAX_CONNECTIONS=50

# Timeout in seconds for acquiring a connection from the pool (default: 30)
# Increase for high-latency environments like CNPG (recommended: 60)
DATABASE_ACQUIRE_TIMEOUT=30

# Timeout in seconds for idle connections before they're closed (default: 600 = 10 minutes)
# Shorter values help with connection recycling in CNPG (recommended: 300 = 5 minutes)
DATABASE_IDLE_TIMEOUT=600

# Maximum lifetime in seconds for any connection (default: 1800 = 30 minutes)
# Prevents long-lived connections from becoming stale
DATABASE_MAX_LIFETIME=1800

# Recommended settings for CNPG environments:
# DATABASE_MIN_CONNECTIONS=10
# DATABASE_MAX_CONNECTIONS=30
# DATABASE_ACQUIRE_TIMEOUT=60
# DATABASE_IDLE_TIMEOUT=300
# DATABASE_MAX_LIFETIME=1800